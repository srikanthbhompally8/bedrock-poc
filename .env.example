# Copy to `.env` (or export these in your shell) before running the POC.
# The app reads them via the standard AWS credential/config chain + os.environ.

# --- AWS Bedrock model ---
# The Bedrock model ID to call. Must be a model you have enabled under
# "Model access" in the Bedrock console, in the region below. Some models require a
# region-prefixed "inference profile" ID (e.g. us.anthropic.claude-...).
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# --- AWS region + credentials ---
# Region hosting the Bedrock runtime endpoint you want to use.
AWS_REGION=us-east-1

# Credentials: prefer `aws configure`, SSO, or an IAM role. Only set these directly
# for a quick local test — never commit real keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
