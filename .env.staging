# Staging Environment Configuration
# ===================================
# For staging/pre-production testing environment.

# Application
APP_NAME=Bedrock POC
ENVIRONMENT=staging
DEBUG=true
API_VERSION=v1
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Database (AWS RDS PostgreSQL)
DB_HOST=bedrock-staging-rds.xxxxxxxxxxxxx.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres_staging
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=bedrock_staging
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_RECYCLE=3600
DB_ECHO_QUERIES=false
DB_SSL_MODE=prefer

# Redis Cache (AWS ElastiCache)
REDIS_HOST=bedrock-staging-redis.xxxxxxxxxxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD
REDIS_DB=0
REDIS_TTL_SECONDS=1800
REDIS_ENABLED=true

# AWS Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
BEDROCK_REQUEST_TIMEOUT=300
BEDROCK_MAX_RETRIES=3

# Authentication & Security
AUTH_JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_256BIT_KEY
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_HOURS=24
AUTH_API_KEY_PREFIX=sk_
AUTH_RATE_LIMIT_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ENABLE_CORS=true
AUTH_CORS_ORIGINS=https://staging.yourdomain.com,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ENABLE_REQUEST_LOGGING=true
LOG_ENABLE_DATABASE_LOGGING=false
LOG_LOG_FILE=/var/log/bedrock-poc/app.log
LOG_SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID

# Monitoring
MONITOR_ENABLE_METRICS=true
MONITOR_METRICS_PORT=9090
MONITOR_ENABLE_HEALTH_CHECKS=true
MONITOR_HEALTH_CHECK_INTERVAL=30
MONITOR_ENABLE_REQUEST_TRACING=true
MONITOR_JAEGER_ENABLED=true
MONITOR_JAEGER_HOST=bedrock-staging-jaeger.xxxxxxxxxxxxx.elb.amazonaws.com
MONITOR_JAEGER_PORT=6831

# Features
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
