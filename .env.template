# Complete Environment Configuration Template
# ============================================
# Copy this to .env and fill in your values.
# Different environments (.env.development, .env.staging, .env.production) can override these.

# === APPLICATION SETTINGS ===

# Application name (used in logs, metrics, etc.)
APP_NAME=Bedrock POC

# Environment: development, staging, or production
# This controls feature flags, default values, and validation rules
ENVIRONMENT=development

# Enable debug mode (verbose logging, auto-reload)
DEBUG=false

# API version for versioning endpoints
API_VERSION=v1

# URL prefix for all API routes
API_PREFIX=/api


# === SERVER SETTINGS ===

# Server host to bind to
# Use 0.0.0.0 for production (behind reverse proxy)
# Use 127.0.0.1 for local development only
HOST=0.0.0.0

# Server port
PORT=8000

# Number of worker processes (for production deployment)
# Rule: workers = (2 * CPU cores) + 1
# Development: 2-4 workers
# Production: 8-16 workers
WORKERS=4

# Enable auto-reload on code changes (development only)
RELOAD=false


# === DATABASE SETTINGS ===
# PostgreSQL connection parameters

# Database hostname/IP
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database username
DB_USER=postgres

# Database password
# IMPORTANT: Keep this secure! Never commit real passwords.
# Use AWS Secrets Manager, environment variables, or .env.local
DB_PASSWORD=postgres

# Database name
DB_NAME=bedrock_poc

# Connection pool minimum size
# Minimum connections to keep open
DB_POOL_MIN_SIZE=5

# Connection pool maximum size
# Maximum concurrent connections allowed
# Increase for high-concurrency production deployments
DB_POOL_MAX_SIZE=20

# Connection recycle time (seconds)
# Connections are recycled after this time to prevent issues with proxy resets
DB_POOL_RECYCLE=3600

# Enable SQL query logging to console
# IMPORTANT: Only enable for debugging, impacts performance
DB_ECHO_QUERIES=false

# SSL mode for database connection
# Options: disable, allow, prefer, require
# Production: require (with valid certificate)
DB_SSL_MODE=prefer


# === REDIS CACHE SETTINGS ===
# Optional: for caching and session management

# Redis hostname/IP
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (optional)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Cache TTL in seconds
REDIS_TTL_SECONDS=3600

# Enable Redis caching
# Set to true to enable, false to disable (use in-memory cache)
REDIS_ENABLED=false


# === AWS BEDROCK SETTINGS ===

# Bedrock model ID to use
# Check AWS Bedrock console for available models in your region
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS region where Bedrock models are available
AWS_REGION=us-east-1

# Bedrock API request timeout (seconds)
# Increase if parsing large documents or dealing with slow networks
BEDROCK_REQUEST_TIMEOUT=300

# Maximum retries for Bedrock API calls
BEDROCK_MAX_RETRIES=3


# === AUTHENTICATION & SECURITY SETTINGS ===

# JWT secret key for signing tokens
# CRITICAL: Generate a secure random string (at least 256 bits)
# Development: can use a simple string
# Production: MUST be a cryptographically secure random value
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET_KEY=change-me-with-a-secure-random-value

# JWT signing algorithm
# Options: HS256, HS512
AUTH_JWT_ALGORITHM=HS256

# JWT token expiration in hours
# How long tokens remain valid before requiring re-authentication
AUTH_JWT_EXPIRATION_HOURS=24

# API key prefix (used to identify API keys in logs)
AUTH_API_KEY_PREFIX=sk_

# Rate limiting: maximum requests per window
# Set to high number for development, low for production
AUTH_RATE_LIMIT_REQUESTS=100

# Rate limiting: window size in seconds
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Enable CORS (Cross-Origin Resource Sharing)
# Set to false in production (use reverse proxy for CORS)
AUTH_ENABLE_CORS=true

# Comma-separated list of allowed CORS origins
# Example: https://example.com,https://app.example.com
AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:8501


# === LOGGING SETTINGS ===

# Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for development, INFO for staging/production
LOG_LEVEL=INFO

# Log format
# Options: json (structured), text (human-readable)
# Use json for production (easier to parse in ELK/CloudWatch)
LOG_FORMAT=text

# Enable HTTP request logging
# Logs all incoming requests (method, path, status, duration)
LOG_ENABLE_REQUEST_LOGGING=true

# Enable database query logging
# Logs all SQL queries (impacts performance)
LOG_ENABLE_DATABASE_LOGGING=false

# Optional: log file path
# If set, logs are written to this file in addition to console
# Leave empty to log to console only
LOG_LOG_FILE=

# Sentry DSN for error tracking (optional)
# Sign up at https://sentry.io to get your DSN
# Leave empty to disable Sentry integration
LOG_SENTRY_DSN=


# === MONITORING & METRICS SETTINGS ===

# Enable Prometheus metrics endpoint
# Exposes metrics at /metrics endpoint
MONITOR_ENABLE_METRICS=true

# Metrics server port
# Prometheus scrapes metrics from this port
MONITOR_METRICS_PORT=9090

# Enable health check endpoints
# Exposes /health, /health/ready, /health/live endpoints
MONITOR_ENABLE_HEALTH_CHECKS=true

# Health check interval (seconds)
# How often to run internal health checks
MONITOR_HEALTH_CHECK_INTERVAL=30

# Enable distributed request tracing
# For integration with Jaeger or other tracing systems
MONITOR_ENABLE_REQUEST_TRACING=false

# Enable Jaeger tracing
# Set to true to send traces to Jaeger
MONITOR_JAEGER_ENABLED=false

# Jaeger collector hostname
MONITOR_JAEGER_HOST=localhost

# Jaeger collector port
MONITOR_JAEGER_PORT=6831


# === FEATURE FLAGS ===

# Enable audit logging (tracks all user actions)
# Required for compliance, should always be true in production
ENABLE_AUDIT_LOGGING=true

# Enable rate limiting
# Should be true in production, can be false for development
ENABLE_RATE_LIMITING=true


# === AWS CREDENTIALS ===
# Optional: only set if not using IAM roles or AWS credential chain

# AWS access key ID
# Prefer: aws configure, IAM roles, or environment variables
# AWS_ACCESS_KEY_ID=

# AWS secret access key
# Prefer: aws configure, IAM roles, or environment variables
# AWS_SECRET_ACCESS_KEY=

# AWS session token (for temporary credentials)
# AWS_SESSION_TOKEN=


# === ENVIRONMENT-SPECIFIC NOTES ===

# Development Environment:
# - DEBUG=true
# - ENVIRONMENT=development
# - REDIS_ENABLED=false (optional)
# - RELOAD=true
# - Minimal security restrictions

# Staging Environment:
# - DEBUG=true
# - ENVIRONMENT=staging
# - REDIS_ENABLED=true
# - RELOAD=false
# - Similar to production, but with debug enabled for troubleshooting

# Production Environment:
# - DEBUG=false
# - ENVIRONMENT=production
# - REDIS_ENABLED=true
# - AUTH_JWT_SECRET_KEY=<secure random value>
# - LOG_FORMAT=json
# - All credentials from Secrets Manager or environment variables
# - CORS_ORIGINS set to specific trusted origins
